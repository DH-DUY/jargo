<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Background (Gradient) -->
    <View
        android:id="@+id/viewHeader"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_gradient_primary"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo Image -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="220dp"
        android:layout_height="70dp"
        android:layout_marginTop="72dp"
        android:src="@drawable/jargo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:text="@string/app_tagline"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:alpha="0.9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <!-- Auth Card (Bottom Sheet Style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAuth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewHeader"
        app:layout_constraintVertical_bias="0.3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="40dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_welcome"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/auth_subtitle"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />

            <!-- Google Sign In Button -->
            <Button
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/btn_google_sign_in"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/text_primary"
                android:drawableStart="@drawable/ic_google"
                android:drawablePadding="@dimen/padding_medium"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:background="@drawable/button_google"
                android:textAllCaps="false"
                android:elevation="2dp"
                tools:ignore="ButtonStyle" />

            <!-- Continue as Guest Button -->
            <Button
                android:id="@+id/btnContinueAsGuest"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/btn_continue_as_guest"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/primary"
                android:background="@drawable/button_secondary"
                android:textAllCaps="false"
                tools:ignore="ButtonStyle" />

            <!-- Email Login Button -->
            <Button
                android:id="@+id/btnEmailLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:text="@string/btn_email_login"
                android:textSize="@dimen/button_text_size"
                android:textColor="@color/primary"
                android:background="@drawable/button_secondary"
                android:textAllCaps="false"
                tools:ignore="ButtonStyle" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Loading View -->
    <FrameLayout
        android:id="@+id/loadingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/overlay_light"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

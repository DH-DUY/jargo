<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_large">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_select_level"
            android:textSize="@dimen/text_size_heading"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Radio Group cho các trình độ -->
        <RadioGroup
            android:id="@+id/radioGroupLevels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xlarge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <!-- Beginner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <RadioButton
                    android:id="@+id/rbBeginner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_medium"
                    android:text="@string/level_beginner"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:drawablePadding="@dimen/padding_medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="40dp"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingBottom="@dimen/padding_medium"
                    android:text="@string/level_beginner_desc"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/text_secondary" />
            </androidx.cardview.widget.CardView>

            <!-- Intermediate -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <RadioButton
                    android:id="@+id/rbIntermediate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_medium"
                    android:text="@string/level_intermediate"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:drawablePadding="@dimen/padding_medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="40dp"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingBottom="@dimen/padding_medium"
                    android:text="@string/level_intermediate_desc"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/text_secondary" />
            </androidx.cardview.widget.CardView>

            <!-- Professional -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <RadioButton
                    android:id="@+id/rbProfessional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_medium"
                    android:text="@string/level_professional"
                    android:textSize="@dimen/text_size_title"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:drawablePadding="@dimen/padding_medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="40dp"
                    android:paddingStart="@dimen/padding_medium"
                    android:paddingEnd="@dimen/padding_medium"
                    android:paddingBottom="@dimen/padding_medium"
                    android:text="@string/level_professional_desc"
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/text_secondary" />
            </androidx.cardview.widget.CardView>

        </RadioGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>

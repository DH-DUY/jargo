<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".JargoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jargo">
        
        <!-- SplashActivity - Màn hình khởi động đầu tiên -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Jargo.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- AuthenticationActivity - Màn hình chọn phương thức đăng nhập -->
        <activity
            android:name=".activities.AuthenticationActivity"
            android:exported="false"
            android:theme="@style/Theme.Jargo" />
        
        <!-- OnboardingActivity - Màn hình chọn chuyên ngành và trình độ -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Jargo" />
        
        <!-- MainActivity - Màn hình chính của app -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        
        <!-- LessonListActivity - Danh sách bài học -->
        <activity
            android:name=".activities.LessonListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        
        <!-- LearningActivity - Học từ vựng với flashcards -->
        <activity
            android:name=".activities.LearningActivity"
            android:exported="false"
            android:parentActivityName=".activities.LessonListActivity" />
        
        <!-- QuizActivity - Làm quiz -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false"
            android:parentActivityName=".activities.LearningActivity" />
        
        <!-- ResultActivity - Kết quả quiz -->
        <activity
            android:name=".activities.ResultActivity"
            android:exported="false" />
        
        <!-- LoginActivity - Đăng nhập -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Jargo" />
        
        <!-- RegisterActivity - Đăng ký tài khoản -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Jargo" />
        
        <!-- LoginHistoryActivity - Lịch sử đăng nhập -->
        <activity
            android:name=".activities.LoginHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Jargo" />
            
    </application>

</manifest>